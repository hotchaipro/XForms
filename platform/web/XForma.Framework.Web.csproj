<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The XForma framework on the web: .NET on WebAssembly, with DOM
       elements for layers and native primitives, and canvases for drawing.
       wwwroot/xforma.js is served to apps as _content/XForma.Framework.Web/. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>XForma.Web</RootNamespace>
    <AssemblyName>XForma.Framework.Web</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\framework\XForma.Framework.csproj" />
  </ItemGroup>

</Project>
