<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>XForms.Test.iOS</RootNamespace>
    <ApplicationId>com.hotchaigames.xforms.test</ApplicationId>
    <ApplicationTitle>XForms Test</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\XForms.Test\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <!-- BitmapRenderer looks images up by lowercase file name -->
    <BundleResource Include="..\Content\AboutLogo.png" LogicalName="aboutlogo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\xforms\XForms.csproj" />
    <ProjectReference Include="..\..\themes\basic\XForms.Themes.Basic.csproj" />
    <ProjectReference Include="..\..\spikes\XForms.Xaml\XForms.Xaml.csproj" />
  </ItemGroup>

</Project>
