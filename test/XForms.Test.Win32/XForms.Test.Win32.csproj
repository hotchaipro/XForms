<Project Sdk="Microsoft.NET.Sdk">

  <!-- PROTOTYPE: the XForms test app on the XAML-free Win32 backend -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>XForms.Test.Win32</RootNamespace>
    <AssemblyName>XForms.Test.Win32</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\XForms.Test\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Content\**\*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\framework\XForms.Framework.csproj" />
    <ProjectReference Include="..\..\platform\win32\XForms.Framework.Win32.csproj" />
    <ProjectReference Include="..\..\toolkit\XForms.Toolkit.csproj" />
    <ProjectReference Include="..\..\spikes\XForms.Xaml\XForms.Xaml.csproj" />
  </ItemGroup>

</Project>
