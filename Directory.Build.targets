<Project>
  <!-- Evaluated after each project sets its TargetFramework -->
  <PropertyGroup>
    <SupportedOSPlatformVersion Condition="'$(TargetPlatformIdentifier)' == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetPlatformIdentifier)' == 'android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!--
    The layers (docs/architecture.md): each references only the layers below
    it. A reference to any other XForma project fails the build (XF0002).
  -->
  <PropertyGroup>
    <XFormaAllowedReferences Condition="'$(MSBuildProjectName)' == 'XForma.Framework'">XForma.Analyzers</XFormaAllowedReferences>
    <XFormaAllowedReferences Condition="$(MSBuildProjectName.StartsWith('XForma.Framework.'))">XForma.Framework;XForma.Analyzers</XFormaAllowedReferences>
    <!-- The toolkit stands alone: nothing of XForma -->
    <XFormaAllowedReferences Condition="'$(MSBuildProjectName)' == 'XForma.Toolkit'">(none)</XFormaAllowedReferences>
    <XFormaAllowedReferences Condition="$(MSBuildProjectName.StartsWith('XForma.Toolkit.'))">XForma.Toolkit</XFormaAllowedReferences>
    <!-- XForma, what apps reference: the framework and toolkit, and on each
         platform their platform's assemblies -->
    <XFormaAllowedReferences Condition="'$(MSBuildProjectName)' == 'XForma'">XForma.Analyzers;XForma.Framework;XForma.Toolkit;XForma.Framework.Win32;XForma.Toolkit.Win32;XForma.Framework.Android;XForma.Toolkit.Android;XForma.Framework.iOS;XForma.Toolkit.iOS;XForma.Framework.Web;XForma.Toolkit.Web</XFormaAllowedReferences>
    <XFormaAllowedReferences Condition="$(MSBuildProjectName.StartsWith('XForma.Themes.'))">XForma</XFormaAllowedReferences>
  </PropertyGroup>

  <!--
    The web libraries (Razor class libraries, for their scripts) keep their
    development manifests (*.staticwebassets.runtime.json and
    *.staticwebassets.endpoints.json) out of the apps that reference them: the
    SDK copies them along, and an app's development server (dotnet run,
    dotnet watch) reads the first it finds, which can be a library's, and
    then serves nothing, or not the app's symbols and data. The app's own
    cover the libraries' files.
  -->
  <Target Name="XFormaKeepLibraryManifestsOut" AfterTargets="AddStaticWebAssetsManifest;AddStaticWebAssetEndpointsBuildManifest" BeforeTargets="GetCopyToOutputDirectoryItems" Condition="'$(UsingMicrosoftNETSdkRazor)' == 'true' and '$(OutputType)' == 'Library'">
    <ItemGroup>
      <_XFormaLibraryManifest Include="@(ContentWithTargetPath)" Condition="$([System.String]::Copy('%(ContentWithTargetPath.TargetPath)').EndsWith('.staticwebassets.runtime.json')) or $([System.String]::Copy('%(ContentWithTargetPath.TargetPath)').EndsWith('.staticwebassets.endpoints.json'))" />
      <ContentWithTargetPath Remove="@(_XFormaLibraryManifest)" />
    </ItemGroup>
  </Target>

  <!-- A project's own references (before the SDK adds those that come through them) -->
  <Target Name="XFormaCheckLayerReferences" BeforeTargets="IncludeTransitiveProjectReferences;ResolveProjectReferences;CoreCompile" Condition="'$(XFormaAllowedReferences)' != ''">
    <ItemGroup>
      <_XFormaReferencedProject Include="@(ProjectReference->'%(Filename)')" />
      <_XFormaAllowedProject Include="$(XFormaAllowedReferences)" />
      <_XFormaDisallowedProject Include="@(_XFormaReferencedProject)" Exclude="@(_XFormaAllowedProject)" />
    </ItemGroup>
    <Error Condition="'@(_XFormaDisallowedProject)' != '' and '$(XFormaAllowedReferences)' == '(none)'" Code="XF0002" Text="$(MSBuildProjectName) mustn't reference @(_XFormaDisallowedProject, ', '): it stands alone, referencing nothing of XForma. See docs/architecture.md." />
    <Error Condition="'@(_XFormaDisallowedProject)' != '' and '$(XFormaAllowedReferences)' != '(none)'" Code="XF0002" Text="$(MSBuildProjectName) mustn't reference @(_XFormaDisallowedProject, ', '): its layer may reference only $(XFormaAllowedReferences.Replace(';', ', ')). See docs/architecture.md." />
  </Target>
</Project>
