<Project>
  <!-- Evaluated after each project sets its TargetFramework -->
  <PropertyGroup>
    <SupportedOSPlatformVersion Condition="'$(TargetPlatformIdentifier)' == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetPlatformIdentifier)' == 'android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!--
    The layers (docs/architecture.md): each references only the layers below
    it. A reference to any other XForms project fails the build (XF0002).
  -->
  <PropertyGroup>
    <XFormsAllowedReferences Condition="'$(MSBuildProjectName)' == 'XForms.Framework'">XForms.Analyzers</XFormsAllowedReferences>
    <XFormsAllowedReferences Condition="$(MSBuildProjectName.StartsWith('XForms.Framework.'))">XForms.Framework;XForms.Analyzers</XFormsAllowedReferences>
    <!-- The toolkit stands alone: nothing of XForms -->
    <XFormsAllowedReferences Condition="'$(MSBuildProjectName)' == 'XForms.Toolkit'">(none)</XFormsAllowedReferences>
    <XFormsAllowedReferences Condition="$(MSBuildProjectName.StartsWith('XForms.Toolkit.'))">XForms.Toolkit</XFormsAllowedReferences>
    <!-- XForms, what apps reference: the framework and toolkit, and on each
         platform their platform's assemblies -->
    <XFormsAllowedReferences Condition="'$(MSBuildProjectName)' == 'XForms'">XForms.Framework;XForms.Toolkit;XForms.Framework.Win32;XForms.Toolkit.Win32;XForms.Framework.Android;XForms.Toolkit.Android;XForms.Framework.iOS;XForms.Toolkit.iOS;XForms.Framework.Web;XForms.Toolkit.Web</XFormsAllowedReferences>
    <XFormsAllowedReferences Condition="$(MSBuildProjectName.StartsWith('XForms.Themes.'))">XForms</XFormsAllowedReferences>
  </PropertyGroup>

  <!--
    The web libraries (Razor class libraries, for their scripts) keep their
    development manifests (*.staticwebassets.runtime.json and
    *.staticwebassets.endpoints.json) out of the apps that reference them: the
    SDK copies them along, and an app's development server (dotnet run,
    dotnet watch) reads the first it finds, which can be a library's, and
    then serves nothing, or not the app's symbols and data. The app's own
    cover the libraries' files.
  -->
  <Target Name="XFormsKeepLibraryManifestsOut" AfterTargets="AddStaticWebAssetsManifest;AddStaticWebAssetEndpointsBuildManifest" BeforeTargets="GetCopyToOutputDirectoryItems" Condition="'$(UsingMicrosoftNETSdkRazor)' == 'true' and '$(OutputType)' == 'Library'">
    <ItemGroup>
      <_XFormsLibraryManifest Include="@(ContentWithTargetPath)" Condition="$([System.String]::Copy('%(ContentWithTargetPath.TargetPath)').EndsWith('.staticwebassets.runtime.json')) or $([System.String]::Copy('%(ContentWithTargetPath.TargetPath)').EndsWith('.staticwebassets.endpoints.json'))" />
      <ContentWithTargetPath Remove="@(_XFormsLibraryManifest)" />
    </ItemGroup>
  </Target>

  <!-- A project's own references (before the SDK adds those that come through them) -->
  <Target Name="XFormsCheckLayerReferences" BeforeTargets="IncludeTransitiveProjectReferences;ResolveProjectReferences;CoreCompile" Condition="'$(XFormsAllowedReferences)' != ''">
    <ItemGroup>
      <_XFormsReferencedProject Include="@(ProjectReference->'%(Filename)')" />
      <_XFormsAllowedProject Include="$(XFormsAllowedReferences)" />
      <_XFormsDisallowedProject Include="@(_XFormsReferencedProject)" Exclude="@(_XFormsAllowedProject)" />
    </ItemGroup>
    <Error Condition="'@(_XFormsDisallowedProject)' != '' and '$(XFormsAllowedReferences)' == '(none)'" Code="XF0002" Text="$(MSBuildProjectName) mustn't reference @(_XFormsDisallowedProject, ', '): it stands alone, referencing nothing of XForms. See docs/architecture.md." />
    <Error Condition="'@(_XFormsDisallowedProject)' != '' and '$(XFormsAllowedReferences)' != '(none)'" Code="XF0002" Text="$(MSBuildProjectName) mustn't reference @(_XFormsDisallowedProject, ', '): its layer may reference only $(XFormsAllowedReferences.Replace(';', ', ')). See docs/architecture.md." />
  </Target>
</Project>
