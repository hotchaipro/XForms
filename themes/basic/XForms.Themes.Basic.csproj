<Project Sdk="Microsoft.NET.Sdk">

  <!--
    XForms.Themes.Basic: the first theme for XForms.Controls, a plain, flat
    look. An app chooses it in Application.CreateTheme.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>XForms.Themes.Basic</RootNamespace>
    <AssemblyName>XForms.Themes.Basic</AssemblyName>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\xforms\XForms.csproj" />
  </ItemGroup>

</Project>
