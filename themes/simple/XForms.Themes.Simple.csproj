<Project Sdk="Microsoft.NET.Sdk">

  <!--
    XForms.Themes.Simple: the first theme for XForms.Controls, a plain, flat
    look. An app chooses it in Application.CreateTheme.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>XForms.Themes.Simple</RootNamespace>
    <AssemblyName>XForms.Themes.Simple</AssemblyName>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\controls\XForms.Controls.csproj" />
  </ItemGroup>

</Project>
