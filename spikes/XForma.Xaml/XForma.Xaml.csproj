<Project Sdk="Microsoft.NET.Sdk">

  <!--
    THROWAWAY SPIKE: a minimal XAML layer built only on the public XForma
    framework API, to find out which framework APIs a XAML layer needs (see
    docs/alignment.md, "Could other UI frameworks be built on XForma?").
    It references only XForma.Framework, so the compiler blocks framework
    internals and platform code.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>XForma.Xaml</RootNamespace>
    <AssemblyName>XForma.Xaml</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\framework\XForma.Framework.csproj" />
    <ProjectReference Include="..\..\xforma\XForma.csproj" />
  </ItemGroup>

</Project>
