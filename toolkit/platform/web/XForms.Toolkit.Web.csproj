<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The toolkit's services in the browser. wwwroot/xforms-toolkit.js is
       served to apps as _content/XForms.Toolkit.Web/. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>XForms.Toolkit</RootNamespace>
    <AssemblyName>XForms.Toolkit.Web</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\XForms.Toolkit.csproj" />
  </ItemGroup>

</Project>
