<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The toolkit's services in the browser. wwwroot/xforma-toolkit.js is
       served to apps as _content/XForma.Toolkit.Web/. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>XForma.Toolkit</RootNamespace>
    <AssemblyName>XForma.Toolkit.Web</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\XForma.Toolkit.csproj" />
  </ItemGroup>

</Project>
