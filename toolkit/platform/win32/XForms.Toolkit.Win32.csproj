<Project Sdk="Microsoft.NET.Sdk">

  <!-- The toolkit's services on Windows: the clipboard, the shell, the common
       file dialogs, DPAPI-protected storage and the network. -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>XForms.Toolkit</RootNamespace>
    <AssemblyName>XForms.Toolkit.Win32</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="NativeMethods.txt" />
    <AdditionalFiles Include="NativeMethods.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.269" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\XForms.Toolkit.csproj" />
  </ItemGroup>

</Project>
