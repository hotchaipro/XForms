<Project Sdk="Microsoft.NET.Sdk">

  <!--
    XForms.Toolkit: what apps use besides controls, for any control set: the
    platform services (clipboard, preferences, sharing, files, ...), which
    each platform implements, and data binding.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>XForms</RootNamespace>
    <AssemblyName>XForms.Toolkit</AssemblyName>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\framework\XForms.Framework.csproj" />
  </ItemGroup>

</Project>
